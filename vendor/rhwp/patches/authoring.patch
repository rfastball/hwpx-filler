+/// 텍스트 노드 — `&`·`<`·`>` 만 이스케이프하고 줄바꿈(CR·LF)은 원문 그대로 쓴다.
+///
+/// quick-xml 의 기본 텍스트 이스케이프는 CR 을 `&#13;` 로 바꾼다. 한컴은 개체 설명
+/// (`hp:shapeComment`) 줄바꿈을 CRLF 원문으로 적는데, 원문 CRLF 는 XML 파서가 LF 로
+/// 정규화해 읽지만 `&#13;` 은 CR 문자로 남는다. 그래서 무편집 저장이 설명 텍스트의
+/// 줄바꿈을 LF 에서 CRLF 로 바꿨다. 원문 CR 을 그대로 두면 한컴 원본과 같은 바이트가 된다.
+pub fn text_keep_line_ends<W: Write>(
+    w: &mut Writer<W>,
+    content: &str,
+) -> Result<(), SerializeError> {
+    let filtered = filter_xml_1_0_chars(content);
+    let mut escaped = String::with_capacity(filtered.len());
+    for c in filtered.chars() {
+        match c {
+            '&' => escaped.push_str("&amp;"),
+            '<' => escaped.push_str("&lt;"),
+            '>' => escaped.push_str("&gt;"),
+            _ => escaped.push(c),
+        }
+    }
+    w.write_event(Event::Text(BytesText::from_escaped(escaped)))
+        .map_err(|e| SerializeError::XmlError(e.to_string()))?;
+    Ok(())
+}
