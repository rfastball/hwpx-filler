diff --git a/rhwp-studio/src/engine/overlay-relayout.ts b/rhwp-studio/src/engine/overlay-relayout.ts
new file mode 100644
index 000000000..af541c610
--- /dev/null
+++ b/rhwp-studio/src/engine/overlay-relayout.ts
@@ -0,0 +1,65 @@
+/**
+ * Embedded host overlays (semantic markers, labels, the body selection and the caret) are
+ * absolute boxes in `#scroll-content` coordinates. Those coordinates move whenever the page
+ * geometry does: the host resizes the frame (a side panel, a dock or the window), the studio
+ * re-lays out or adds/removes horizontal pan space, or the zoom changes. This scheduler turns
+ * every such trigger into at most one relayout per animation frame, after the studio's own
+ * synchronous `recalcLayout` has run. It never polls.
+ */
+export interface OverlayRelayoutDeps {
+  requestFrame(callback: () => void): number;
+  cancelFrame(handle: number): void;
+  /** Size observer factory; omitted where ResizeObserver does not exist. */
+  createObserver?: (callback: () => void) => { observe(target: Element): void; disconnect(): void };
+}
+
+export class OverlayRelayout {
+  private frame: number | null = null;
+  private observer: { observe(target: Element): void; disconnect(): void } | null = null;
+  private readonly watched = new Set<Element>();
+  private disposed = false;
+  private readonly deps: OverlayRelayoutDeps;
+  private readonly run: () => void;
+
+  constructor(deps: OverlayRelayoutDeps, run: () => void) {
+    this.deps = deps;
+    this.run = run;
+    this.observer = deps.createObserver?.(() => this.schedule()) ?? null;
+  }
+
+  /** Coalesce: several triggers in one frame run the relayout once. */
+  schedule(): void {
+    if (this.disposed || this.frame !== null) return;
+    this.frame = this.deps.requestFrame(() => {
+      this.frame = null;
+      if (!this.disposed) this.run();
+    });
+  }
+
+  /** Relayout when this element's box changes size (idempotent per element). */
+  watch(target: Element | null | undefined): void {
+    if (!target || this.disposed || !this.observer || this.watched.has(target)) return;
+    this.watched.add(target);
+    this.observer.observe(target);
+  }
+
+  dispose(): void {
+    this.disposed = true;
+    if (this.frame !== null) this.deps.cancelFrame(this.frame);
+    this.frame = null;
+    this.observer?.disconnect();
+    this.observer = null;
+    this.watched.clear();
+  }
+}
+
+/** Browser wiring: rAF plus ResizeObserver when available. */
+export function browserOverlayRelayout(run: () => void): OverlayRelayout {
+  return new OverlayRelayout({
+    requestFrame: (callback) => requestAnimationFrame(callback),
+    cancelFrame: (handle) => cancelAnimationFrame(handle),
+    createObserver: typeof ResizeObserver === 'function'
+      ? (callback) => new ResizeObserver(() => callback())
+      : undefined,
+  }, run);
+}
