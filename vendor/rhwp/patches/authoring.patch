+test('?autosave=off turns off both the interval and the idle save and is the only switch', () => {
+  assert.equal(hostDisablesAutosave('?hostTheme=dark&autosave=off'), true);
+  assert.deepEqual(hostAutosaveSchedule('?autosave=off', settings), { ...settings, recoveryEnabled: false, idleEnabled: false });
