new file mode 100644
index 000000000..277746476
--- /dev/null
+++ b/rhwp-studio/src/engine/region-box.ts
@@ -0,0 +1,33 @@
+/** A page-coordinate rectangle (zoom 1): text line rects, table/object layout boxes. */
+export type PageRect = { pageIndex: number; x: number; y: number; width: number; height: number };
+/** One region box on one page: the region's extent there, with the edges a page break cuts left open. */
+export type RegionBox = PageRect & { openTop: boolean; openBottom: boolean };
+
+/**
+ * One clean box per page for a 항목/선택 region (the embedded authoring overlay), instead of a box per text line.
+ *
+ * `parts` are everything the region lays out: its text lines and the tables/objects anchored in its paragraphs. On each
+ * page the box spans the body column (`columns`, widened when content reaches past it) and runs from the region's first
+ * part to its last there. A region that continues across a page break leaves the bottom edge open on the earlier page
+ * and the top edge open on the later one. `outset` grows the box on every side (page px) — a 항목 box sits outside its
+ * 선택 boxes so nesting stays visible.
+ */
+export function regionBoxes(parts: readonly PageRect[], columns: ReadonlyMap<number, { left: number; right: number }>,
+                            outset = 0): RegionBox[] {
+  const byPage = new Map<number, PageRect[]>();
+  for (const part of parts) {
+    if (![part.x, part.y, part.width, part.height].every(Number.isFinite) || part.height <= 0) continue;
+    byPage.set(part.pageIndex, [...(byPage.get(part.pageIndex) ?? []), part]);
+  }
+  const pages = [...byPage.keys()].sort((a, b) => a - b);
+  return pages.map((pageIndex, at) => {
+    const rects = byPage.get(pageIndex)!;
+    const column = columns.get(pageIndex);
+    const left = Math.min(column?.left ?? Infinity, ...rects.map((rect) => rect.x));
+    const right = Math.max(column?.right ?? -Infinity, ...rects.map((rect) => rect.x + rect.width));
+    const top = Math.min(...rects.map((rect) => rect.y));
+    const bottom = Math.max(...rects.map((rect) => rect.y + rect.height));
+    return { pageIndex, x: left - outset, y: top - outset, width: right - left + outset * 2, height: bottom - top + outset * 2,
+      openTop: at > 0, openBottom: at < pages.length - 1 };
+  });
+}
