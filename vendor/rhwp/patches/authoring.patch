+    /// 표와 표 사이에 있던 종료는 그 사이에 남는다.
+    #[test]
+    fn orphan_field_end_between_trailing_tables_stays_between() {
+        let (first, again) = orphan_order_roundtrip(&format!(
+            "<hp:t>가</hp:t>{ORPHAN_ORDER_TABLE}{ORPHAN_ORDER_END}{ORPHAN_ORDER_TABLE}"
+        ));
+        let end = first.find("<hp:fieldEnd").expect("종료");
+        assert_eq!(first[..end].matches("</hp:tbl>").count(), 1, "첫 표 뒤·둘째 표 앞:\n{first}");
+        assert_eq!(first[end..].matches("<hp:tbl ").count(), 1, "첫 표 뒤·둘째 표 앞:\n{first}");
