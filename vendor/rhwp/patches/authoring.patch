+/// Direct `hp:metaTag` child of a table or object: source text, verbatim.
+fn read_object_meta_tag(
+    reader: &mut Reader<&[u8]>,
+    self_closing: bool,
+) -> Result<String, HwpxError> {
+    if self_closing {
+        Ok(String::new())
+    } else {
+        read_field_meta_tag(reader)
+    }
+}
+
+fn read_field_meta_tag(reader: &mut Reader<&[u8]>) -> Result<String, HwpxError> {
+    let mut text = String::new();
+    let mut buf = Vec::new();
+    loop {
+        match reader.read_event_into(&mut buf) {
+            Ok(Event::Text(ref t)) => text.push_str(t.as_ref()),
+            Ok(Event::GeneralRef(ref r)) => text.push_str(&decode_xml_general_ref(r)),
+            Ok(Event::CData(ref c)) => text.push_str(c.as_ref()),
+            Ok(Event::End(ref e)) if local_name(e.name().as_ref()) == b"metaTag" => break,
+            Ok(Event::Eof) => {
+                return Err(HwpxError::XmlError("unclosed fieldBegin metaTag".into()))
+            }
+            Err(e) => return Err(HwpxError::XmlError(format!("fieldBegin metaTag: {e}"))),
+            _ => {
+                return Err(HwpxError::XmlError(
+                    "fieldBegin metaTag must contain text only".into(),
+                ))
+            }
+        }
+        buf.clear();
+    }
+    Ok(text)
+}
