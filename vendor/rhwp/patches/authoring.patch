--- /dev/null
+++ b/rhwp-studio/src/engine/range-pick.ts
@@ -0,0 +1,28 @@
+import type { DocumentPosition, EmbedPickPoint } from '@/core/types';
+
+/** A hit-test result as a range-pick point: body positions as they are, a table-cell hit folded to the table's anchor
+ *  body paragraph, anything else (text boxes, unresolved positions) none. */
+export function pickPointOf(hit: DocumentPosition | null): EmbedPickPoint | null {
+  if (!hit || hit.isTextBox) return null;
+  const section = hit.sectionIndex;
+  if (hit.parentParaIndex !== undefined) {
+    return Number.isSafeInteger(hit.parentParaIndex) && hit.parentParaIndex >= 0
+      ? { section, paragraph: hit.parentParaIndex, charOffset: 0, cell: true } : null;
+  }
+  if (!Number.isSafeInteger(hit.paragraphIndex) || !Number.isSafeInteger(hit.charOffset)) return null;
+  return { section, paragraph: hit.paragraphIndex, charOffset: hit.charOffset, cell: false };
+}
+
+/** The body range between two pick points (either order) — `endOffset: null` is the end paragraph's end. A cell point
+ *  covers its whole table paragraph; two points in different sections have no range. */
+export function pickRange(a: EmbedPickPoint, b: EmbedPickPoint): { section: number; startParagraph: number; startOffset: number;
+  endParagraph: number; endOffset: number | null } | null {
+  if (a.section !== b.section) return null;
+  const [first, second] = a.paragraph < b.paragraph || (a.paragraph === b.paragraph && a.charOffset <= b.charOffset) ? [a, b] : [b, a];
+  const whole = first.paragraph === second.paragraph && (first.cell || second.cell);
+  return { section: first.section, startParagraph: first.paragraph, startOffset: whole || first.cell ? 0 : first.charOffset,
+    endParagraph: second.paragraph, endOffset: whole || second.cell ? null : second.charOffset };
+}
+
+/** Pointer travel (CSS px) under which a press and release is a click, not a drag. */
+export const PICK_CLICK_SLOP = 5;
