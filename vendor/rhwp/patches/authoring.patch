diff --git a/rhwp-studio/tests/overlay-relayout.test.ts b/rhwp-studio/tests/overlay-relayout.test.ts
new file mode 100644
index 000000000..82d306a88
--- /dev/null
+++ b/rhwp-studio/tests/overlay-relayout.test.ts
@@ -0,0 +1,88 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { OverlayRelayout } from '../src/engine/overlay-relayout.ts';
+import { functionBodyFrom } from './support/source-guard.ts';
+
+function harness() {
+  const frames = new Map<number, () => void>();
+  let next = 1;
+  const observed: unknown[] = [];
+  let observerCallback: (() => void) | null = null;
+  let disconnected = false;
+  let runs = 0;
+  const relayout = new OverlayRelayout({
+    requestFrame: (callback) => { const id = next++; frames.set(id, callback); return id; },
+    cancelFrame: (id) => { frames.delete(id); },
+    createObserver: (callback) => {
+      observerCallback = callback;
+      return { observe: (target) => { observed.push(target); }, disconnect: () => { disconnected = true; } };
+    },
+  }, () => { runs++; });
+  const flush = () => { const pending = [...frames.values()]; frames.clear(); pending.forEach((cb) => cb()); };
+  return { relayout, frames, observed, flush, resize: () => observerCallback?.(),
+    runs: () => runs, disconnected: () => disconnected };
+}
+
+test('several layout triggers in one frame relayout the overlay once', () => {
+  const h = harness();
+  h.relayout.schedule();
+  h.relayout.schedule();
+  h.resize();
+  assert.equal(h.frames.size, 1);
+  assert.equal(h.runs(), 0, 'relayout waits for the frame, after the studio recalcLayout');
+  h.flush();
+  assert.equal(h.runs(), 1);
+  h.resize();
+  h.flush();
+  assert.equal(h.runs(), 2, 'a later resize schedules again');
+});
+
+test('watched containers relayout on resize and are observed once', () => {
+  const h = harness();
+  const container = {} as Element;
+  h.relayout.watch(container);
+  h.relayout.watch(container);
+  h.relayout.watch(null);
+  assert.deepEqual(h.observed, [container]);
+  h.resize();
+  h.flush();
+  assert.equal(h.runs(), 1);
+});
+
+test('dispose cancels the pending frame and disconnects the observer', () => {
+  const h = harness();
+  h.relayout.schedule();
+  h.relayout.dispose();
+  assert.equal(h.frames.size, 0);
+  assert.equal(h.disconnected(), true);
+  h.relayout.schedule();
+  h.resize();
+  assert.equal(h.frames.size, 0);
+  assert.equal(h.runs(), 0);
+});
+
+test('InputHandler re-lays out embedded overlays on every page-geometry change', () => {
+  const src = readFileSync(new URL('../src/engine/input-handler.ts', import.meta.url), 'utf8');
+  for (const event of ['viewport-resize', 'document-layout-refreshed', 'document-view-changed', 'zoom-changed']) {
+    assert.ok(src.includes(`eventBus.on('${event}', () => this.overlayRelayout.schedule());`), event);
+  }
+  const relayout = functionBodyFrom(src, 'private relayoutEmbedOverlays(');
+  assert.match(relayout, /this\.renderSemanticMarkers\(\)/);
+  assert.match(relayout, /this\.reprojectCursorOverlays\(\)/);
+  const render = functionBodyFrom(src, 'private renderSemanticMarkers(');
+  assert.match(render, /this\.overlayRelayout\.watch\(scrollContent\)/);
+  assert.match(functionBodyFrom(src, 'dispose(): void'), /this\.overlayRelayout\.dispose\(\)/);
+});
+
+test('scrollBodyRangeIntoView moves only the viewport; the selection end rect waits for a pointer drag to end', () => {
+  const src = readFileSync(new URL('../src/engine/input-handler.ts', import.meta.url), 'utf8');
+  const scroll = functionBodyFrom(src, 'scrollBodyRangeIntoView(');
+  assert.match(scroll, /this\.container\.scrollTop = /);
+  for (const moves of [/cursor\./, /focusTextarea/, /updateCaret/, /\.focus\(/, /this\.active = /]) {
+    assert.doesNotMatch(scroll, moves, `scroll-to-range must not ${moves}`);
+  }
+  assert.match(functionBodyFrom(src, 'embedSelectionEndClientRect('), /return this\.isDragging \? null : this\.embedCaretClientRect\(\);/);
+  // Problem markers explain themselves by the hover tooltip and never float a label chip.
+  assert.match(functionBodyFrom(src, 'private renderSemanticLabels('), /item\.marker\.kind !== 'problem'/);
+});
diff --git a/rhwp-studio/tests/range-pick.test.ts b/rhwp-studio/tests/range-pick.test.ts
new file mode 100644
index 000000000..baacefc96
--- /dev/null
+++ b/rhwp-studio/tests/range-pick.test.ts
@@ -0,0 +1,36 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import { pickPointOf, pickRange } from '../src/engine/range-pick.ts';
+import { routeEmbedRequest, type EmbedRpcHandlers } from '../src/embed/rpc-router.ts';
+
+const body = (paragraphIndex: number, charOffset: number) => ({ sectionIndex: 0, paragraphIndex, charOffset });
+
+test('range pick points: body hits as they are, a cell hit folds to its table anchor paragraph, text boxes have none', () => {
+  assert.deepEqual(pickPointOf(body(4, 7) as never), { section: 0, paragraph: 4, charOffset: 7, cell: false });
+  assert.deepEqual(pickPointOf({ ...body(0, 3), parentParaIndex: 9, controlIndex: 0, cellIndex: 2, cellParaIndex: 0 } as never),
+    { section: 0, paragraph: 9, charOffset: 0, cell: true });
+  assert.equal(pickPointOf({ ...body(1, 1), isTextBox: true } as never), null);
+  assert.equal(pickPointOf(null), null);
+});
+
+test('range pick ranges order the points and cover a whole table paragraph for a cell edge', () => {
+  const p = (paragraph: number, charOffset: number, cell = false) => ({ section: 0, paragraph, charOffset, cell });
+  assert.deepEqual(pickRange(p(5, 3), p(2, 1)), { section: 0, startParagraph: 2, startOffset: 1, endParagraph: 5, endOffset: 3 });
+  assert.deepEqual(pickRange(p(2, 4), p(9, 0, true)), { section: 0, startParagraph: 2, startOffset: 4, endParagraph: 9, endOffset: null });
+  assert.deepEqual(pickRange(p(9, 0, true), p(9, 0, true)), { section: 0, startParagraph: 9, startOffset: 0, endParagraph: 9, endOffset: null });
+  assert.equal(pickRange(p(1, 0), { ...p(1, 0), section: 1 }), null);
+});
+
+test('embed router setRangePick takes enabled and an exact start point', async () => {
+  const calls: unknown[] = [];
+  const handlers = { setRangePick: async (enabled: unknown, start: unknown) => { calls.push([enabled, start]); } } as unknown as EmbedRpcHandlers;
+  const start = { section: 0, paragraph: 3, charOffset: 2, cell: false };
+  await routeEmbedRequest('setRangePick', { enabled: true, start }, handlers);
+  await routeEmbedRequest('setRangePick', { enabled: false }, handlers);
+  for (const bad of [{ enabled: 'yes' }, { enabled: true, start: { ...start, paragraph: -1 } }, { enabled: true, start: { ...start, extra: 1 } },
+    { enabled: true, start: { ...start, cell: 1 } }, { enabled: true, extra: 1 }]) {
+    await assert.rejects(() => routeEmbedRequest('setRangePick', bad, handlers));
+  }
+  assert.deepEqual(calls, [[true, start], [false, null]]);
+});
diff --git a/rhwp-studio/tests/region-box.test.ts b/rhwp-studio/tests/region-box.test.ts
new file mode 100644
index 000000000..74446e33a
--- /dev/null
+++ b/rhwp-studio/tests/region-box.test.ts
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import { regionBoxes } from '../src/engine/region-box.ts';
+
+const column = new Map([[0, { left: 50, right: 550 }], [1, { left: 50, right: 550 }]]);
+const line = (pageIndex: number, y: number, width = 200) => ({ pageIndex, x: 60, y, width, height: 18 });
+
+test('a region is one box over the body column from its first line to its last part, table included', () => {
+  const table = { pageIndex: 0, x: 55, y: 140, width: 480, height: 90 };
+  assert.deepEqual(regionBoxes([line(0, 100), line(0, 120, 80), table], column), [
+    { pageIndex: 0, x: 50, y: 100, width: 500, height: 130, openTop: false, openBottom: false },
+  ]);
+  // A table wider than the column widens the box instead of spilling out of it.
+  const wide = { pageIndex: 0, x: 40, y: 140, width: 530, height: 20 };
+  assert.deepEqual(regionBoxes([line(0, 100), wide], column)[0], { pageIndex: 0, x: 40, y: 100, width: 530, height: 60, openTop: false, openBottom: false });
+});
+
+test('a region across a page break is one box per page with the cut edges open', () => {
+  const boxes = regionBoxes([line(0, 700), line(0, 720), { pageIndex: 1, x: 55, y: 80, width: 300, height: 40 }, line(1, 130)], column);
+  assert.deepEqual(boxes.map((box) => [box.pageIndex, box.y, box.height, box.openTop, box.openBottom]),
+    [[0, 700, 38, false, true], [1, 80, 68, true, false]]);
+});
+
+test('the outset nests a 선택 box visibly inside its 항목 box', () => {
+  const parts = [line(0, 100), line(0, 200)];
+  const [slot] = regionBoxes(parts, column, 5);
+  const [option] = regionBoxes([line(0, 140)], column, 1);
+  assert.ok(slot.x < option.x && slot.x + slot.width > option.x + option.width, 'the 항목 box is wider on both sides');
+  assert.ok(slot.y < option.y && slot.y + slot.height > option.y + option.height, 'and taller');
+  assert.deepEqual(regionBoxes([], column), []);
+  assert.deepEqual(regionBoxes([{ ...line(0, 1), height: 0 }], column), [], 'empty parts draw nothing');
+});
