+/// Direct `<hp:metaTag>` children of a table or object, source text verbatim and in source
+/// order. Written after shapeComment, the position Hancom output uses (tables: after the
+/// last `hp:tr`).
+pub(super) fn write_meta_tags<W: Write>(
+    w: &mut Writer<W>,
+    c: &CommonObjAttr,
+) -> Result<(), SerializeError> {
+    for meta_tag in &c.hwpx_meta_tags {
+        start_tag(w, "hp:metaTag")?;
+        super::utils::text(w, meta_tag)?;
+        end_tag(w, "hp:metaTag")?;
+    }
+    Ok(())
