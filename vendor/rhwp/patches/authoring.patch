+/// 원본 content.hpf 의 `<opf:manifest> … </opf:manifest>` 블록 원문과 그 항목들의
+/// `(id, href)` 목록. 모든 항목이 `<opf:item … />` 자기닫힘 태그이고 id·href 가 있을
+/// 때만 인식하며, 그 외 형태는 `None` (호출자는 재생성 경로를 쓴다).
+fn extract_manifest_block(original: &str) -> Option<(&str, Vec<(String, String)>)> {
+    let open = original.find("<opf:manifest>")?;
+    let close = original[open..].find("</opf:manifest>")? + open + "</opf:manifest>".len();
+    let block = &original[open..close];
+    let mut inner = &block["<opf:manifest>".len()..block.len() - "</opf:manifest>".len()];
+    let attr = |tag: &str, name: &str| -> Option<String> {
+        let key = format!(" {name}=\"");
+        let start = tag.find(&key)? + key.len();
+        let end = tag[start..].find('"')? + start;
+        Some(tag[start..end].to_string())
+    };
+    let mut items = Vec::new();
+    while !inner.is_empty() {
+        if !inner.starts_with("<opf:item ") {
+            return None;
+        }
+        let end = inner.find("/>")? + 2;
+        let tag = &inner[..end];
+        if tag[..tag.len() - 2].contains('>') {
+            return None;
+        }
+        items.push((attr(tag, "id")?, attr(tag, "href")?));
+        inner = &inner[end..];
+    }
+    Some((block, items))
+}
