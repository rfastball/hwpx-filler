@@ -0,0 +1,30 @@
+/** Horizontal ink extent of one glyph, in em, from the glyph's pen origin (its box's left edge). */
+export type GlyphInk = { left: number; right: number };
+
+/**
+ * Where the 누름틀 낫표 boxes go so the visible strokes, not the glyph boxes, sit on the field boundaries.
+ *
+ * A font draws 「 and 」 anywhere inside their advance (Malgun Gothic: 「 ink 0.21–0.53em, 」 ink 0.04–0.36em), so a box
+ * whose left edge is the boundary shows 「 inside the field's first character and 」 after a gap past its last one — both
+ * read as shifted right. Here the 「 ink starts at the field start and the 」 ink ends at the field end, so the pair
+ * brackets exactly the field text. `startX`/`endX` and the result are px; `startSize`/`endSize` are the glyph font sizes
+ * (px) the ink is scaled by. Unknown ink (null) keeps the box at the boundary.
+ */
+export function fieldMarkerLefts(startX: number, endX: number, startSize: number, endSize: number,
+  startInk: GlyphInk | null, endInk: GlyphInk | null): { start: number; end: number } {
+  return {
+    start: startInk ? startX - startInk.left * startSize : startX,
+    end: endInk ? endX - endInk.right * endSize : endX,
+  };
+}
+
+/**
+ * The glyph's ink from canvas text metrics (`actualBoundingBoxLeft` is positive leftwards of the pen origin), as em.
+ * Null when the metrics are unusable, so the caller keeps the unadjusted box instead of guessing.
+ */
+export function inkFromMetrics(metrics: { actualBoundingBoxLeft?: number; actualBoundingBoxRight?: number }, size: number): GlyphInk | null {
+  const left = metrics.actualBoundingBoxLeft, right = metrics.actualBoundingBoxRight;
+  if (!(size > 0) || typeof left !== 'number' || typeof right !== 'number' || !Number.isFinite(left) || !Number.isFinite(right)) return null;
+  const ink = { left: -left / size, right: right / size };
+  return ink.right > ink.left ? ink : null;
+}
