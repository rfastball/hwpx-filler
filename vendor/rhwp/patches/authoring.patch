+    fn orphan_field_end_order_is_kept_in_text_less_table_paragraph() {
+        let (after, after_again) = orphan_order_roundtrip(&format!("{ORPHAN_ORDER_TABLE}{ORPHAN_ORDER_END}"));
+        assert_before(&after, "</hp:tbl>", "<hp:fieldEnd");
+        assert_eq!(after, after_again);
+        let (before, before_again) = orphan_order_roundtrip(&format!("{ORPHAN_ORDER_END}{ORPHAN_ORDER_TABLE}"));
