+/* Range pick rubber band (embedded host): the span a second click would choose, drawn like a selection. */
+.rhwp-range-pick-layer { position: absolute; inset: 0; pointer-events: none; z-index: 5; }
+.rhwp-range-pick-mark {
+  position: absolute;
+  pointer-events: none;
+  background: color-mix(in srgb, #3b82f6 26%, transparent);
+  outline: 1px dashed color-mix(in srgb, #3b82f6 70%, transparent);
+}
+.rhwp-range-pick-mark[data-open~="top"] { outline: none; border-bottom: 1px dashed color-mix(in srgb, #3b82f6 70%, transparent); }
+.rhwp-range-pick-mark[data-open~="bottom"] { outline: none; border-top: 1px dashed color-mix(in srgb, #3b82f6 70%, transparent); }
+.rhwp-range-pick-mark[data-open~="top"][data-open~="bottom"] { border: 0; }
+
+.rhwp-semantic-mark {
+  position: absolute;
+  box-sizing: border-box;
+  pointer-events: none;
+  border-radius: 2px;
+}
+
+.rhwp-semantic-mark[data-kind="field"] {
+  background: color-mix(in srgb, var(--rhwp-semantic-field) 16%, transparent);
+  border-bottom: 2px solid var(--rhwp-semantic-field);
+  border-radius: 2px 2px 0 0;
+  mix-blend-mode: multiply;
+}
+
+.rhwp-semantic-mark[data-kind="slot"] { border: 1px dashed var(--rhwp-semantic-slot); }
+.rhwp-semantic-mark[data-kind="option"] { border: 1px dashed var(--rhwp-semantic-option); }
+.rhwp-semantic-mark[data-kind="slot"][data-emphasis="strong"] { border: 2px solid var(--rhwp-semantic-slot); }
+.rhwp-semantic-mark[data-kind="option"][data-emphasis="strong"] { border: 2px solid var(--rhwp-semantic-option); }
+/* A region box cut by a page break keeps that edge open — the region goes on over the break. */
+.rhwp-semantic-mark[data-region][data-open~="top"] { border-top-color: transparent; }
+.rhwp-semantic-mark[data-region][data-open~="bottom"] { border-bottom-color: transparent; }
+
+/* Authoring problems: an underline just below the run, never a fill, so the text and a field tint
+   under it stay readable. Shape tells the severity, not only colour: strong (error) is wavy,
+   subtle (warning) is dotted. The message is the hover tooltip; problems float no label. */
+.rhwp-semantic-mark[data-kind="problem"]::after {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: -4px;
+  height: 4px;
+}
+
+.rhwp-semantic-mark[data-kind="problem"][data-emphasis="strong"]::after {
+  /* A row of small arches (a wave) drawn by a ring gradient — no image, so no external URL. */
+  --rhwp-problem-wave: var(--rhwp-semantic-problem-error);
+  background: radial-gradient(circle at 50% 100%, transparent 1.6px, var(--rhwp-problem-wave) 1.9px 2.9px, transparent 3.2px)
+    0 0 / 6px 4px repeat-x;
+}
+
+.rhwp-semantic-mark[data-kind="problem"][data-emphasis="subtle"]::after {
+  height: 0;
+  bottom: -3px;
+  border-bottom: 2px dotted var(--rhwp-semantic-problem-warning);
+}
+
+.rhwp-semantic-label {
+  position: absolute;
+  padding: 0 4px;
+  border-radius: 3px;
+  background: var(--rhwp-semantic-field);
+  color: #ffffff;
+  font: 11px/14px sans-serif;
+  white-space: nowrap;
+  pointer-events: none;
+}
+
+.rhwp-semantic-label[data-kind="slot"] { background: var(--rhwp-semantic-slot); }
+.rhwp-semantic-label[data-kind="option"] { background: var(--rhwp-semantic-option); }
+
+@media (forced-colors: active) {
+  .rhwp-semantic-mark {
+    forced-color-adjust: none;
+    mix-blend-mode: normal;
+  }
+  .rhwp-semantic-mark[data-kind="field"] {
+    background: transparent;
+    border-bottom-color: Highlight;
+  }
+  .rhwp-semantic-mark[data-kind="slot"],
+  .rhwp-semantic-mark[data-kind="option"] { border-color: Highlight; }
+  .rhwp-semantic-mark[data-kind="problem"][data-emphasis="strong"]::after { --rhwp-problem-wave: CanvasText; }
+  .rhwp-semantic-mark[data-kind="problem"][data-emphasis="subtle"]::after { border-bottom-color: CanvasText; }
+  .rhwp-semantic-label {
+    forced-color-adjust: none;
+    background: Highlight;
+    color: HighlightText;
+  }
+}
+
+/* Host chrome scale (setAppearance fontScale): toolbars and rulers grow, the document zoom
+   does not. The rulers redraw at the new thickness (view/ruler.ts rulerSize). */
+:root[data-host-font-scale] #studio-header {
+  zoom: var(--rhwp-host-font-scale, 1);
+}
+
+:root[data-host-font-scale] #editor-area {
+  grid-template-columns: calc(20px * var(--rhwp-host-font-scale, 1)) minmax(0, 1fr);
+  grid-template-rows: calc(20px * var(--rhwp-host-font-scale, 1)) minmax(0, 1fr);
+}
