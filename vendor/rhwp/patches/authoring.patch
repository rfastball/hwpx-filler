diff --git a/rhwp-studio/tests/field-marker-ink.test.ts b/rhwp-studio/tests/field-marker-ink.test.ts
new file mode 100644
index 000000000..75416f4e2
--- /dev/null
+++ b/rhwp-studio/tests/field-marker-ink.test.ts
@@ -0,0 +1,34 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import { fieldMarkerLefts, inkFromMetrics } from '../src/engine/field-marker-ink.ts';
+
+// Malgun Gothic: 「 ink 426–1092 and 」 ink 72–743 font units of 2048.
+const open = { left: 426 / 2048, right: 1092 / 2048 };
+const close = { left: 72 / 2048, right: 743 / 2048 };
+
+test('the 「 ink starts at the field start and the 」 ink ends at the field end', () => {
+  const { start, end } = fieldMarkerLefts(328, 397, 20, 20, open, close);
+  assert.ok(Math.abs(start + open.left * 20 - 328) < 1e-9, '「 stroke on the start boundary, not inside the first character');
+  assert.ok(Math.abs(end + close.right * 20 - 397) < 1e-9, '」 stroke on the end boundary, not past it');
+  assert.ok(start < 328 && end < 397, 'both boxes move left of the boundaries they used to start at');
+});
+
+test('the ink offset scales with each glyph size', () => {
+  const small = fieldMarkerLefts(100, 200, 10, 10, open, close);
+  const large = fieldMarkerLefts(100, 200, 40, 40, open, close);
+  assert.ok(Math.abs((100 - large.start) - 4 * (100 - small.start)) < 1e-9);
+  assert.ok(Math.abs((200 - large.end) - 4 * (200 - small.end)) < 1e-9);
+});
+
+test('unknown ink keeps the boxes on the boundaries', () => {
+  assert.deepEqual(fieldMarkerLefts(10, 50, 20, 20, null, null), { start: 10, end: 50 });
+});
+
+test('canvas metrics become em ink; unusable metrics are null', () => {
+  assert.deepEqual(inkFromMetrics({ actualBoundingBoxLeft: -20, actualBoundingBoxRight: 50 }, 100), { left: 0.2, right: 0.5 });
+  assert.equal(inkFromMetrics({}, 100), null);
+  assert.equal(inkFromMetrics({ actualBoundingBoxLeft: 0, actualBoundingBoxRight: 0 }, 100), null, 'no ink');
+  assert.equal(inkFromMetrics({ actualBoundingBoxLeft: -20, actualBoundingBoxRight: 50 }, 0), null);
+  assert.equal(inkFromMetrics({ actualBoundingBoxLeft: Number.NaN, actualBoundingBoxRight: 50 }, 100), null);
+});
