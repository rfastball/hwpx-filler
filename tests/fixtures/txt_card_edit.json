{
  "base_marks": [
    {
      "test": "test_base_marks_splits_declared_blank_from_data_blank_and_covers_missing_and_fill",
      "args": [
        [
          {
            "text": "",
            "kind": "blank",
            "name": "a"
          },
          {
            "text": " ",
            "kind": "literal",
            "name": ""
          },
          {
            "text": "",
            "kind": "blank",
            "name": "b"
          },
          {
            "text": " ",
            "kind": "literal",
            "name": ""
          },
          {
            "text": "값",
            "kind": "fill",
            "name": "c"
          },
          {
            "text": " ",
            "kind": "literal",
            "name": ""
          },
          {
            "text": "{{d}}",
            "kind": "missing",
            "name": "d"
          }
        ],
        [
          "a"
        ]
      ],
      "kwargs": {},
      "expected": [
        {
          "kind": "declared",
          "name": "a",
          "start": 0,
          "end": 0
        },
        {
          "kind": "blank",
          "name": "b",
          "start": 1,
          "end": 1
        },
        {
          "kind": "fill",
          "name": "c",
          "start": 2,
          "end": 3
        },
        {
          "kind": "missing",
          "name": "d",
          "start": 4,
          "end": 9
        }
      ]
    },
    {
      "test": "test_base_marks_skips_literal_text",
      "args": [
        [
          {
            "text": "머리말 ",
            "kind": "literal",
            "name": ""
          },
          {
            "text": "값",
            "kind": "fill",
            "name": "x"
          },
          {
            "text": " 꼬리말",
            "kind": "literal",
            "name": ""
          }
        ],
        []
      ],
      "kwargs": {},
      "expected": [
        {
          "kind": "fill",
          "name": "x",
          "start": 4,
          "end": 5
        }
      ]
    }
  ],
  "edit_card": [
    {
      "test": "test_typing_into_a_zero_length_blank_fills_it_and_maps_the_inserted_range",
      "args": [
        "안녕",
        [
          {
            "kind": "blank",
            "name": "X",
            "start": 2,
            "end": 2
          }
        ],
        "안녕하세요"
      ],
      "kwargs": {
        "fullwidth": false
      },
      "expected": {
        "text": "안녕하세요",
        "marks": [
          {
            "kind": "blank",
            "name": "X",
            "start": 2,
            "end": 5
          }
        ],
        "filled": [
          "X"
        ],
        "resolved": [],
        "space_run": false
      }
    },
    {
      "test": "test_typing_only_whitespace_into_a_blank_does_not_count_as_filled",
      "args": [
        "값:",
        [
          {
            "kind": "blank",
            "name": "X",
            "start": 2,
            "end": 2
          }
        ],
        "값:   "
      ],
      "kwargs": {
        "fullwidth": false
      },
      "expected": {
        "text": "값:   ",
        "marks": [
          {
            "kind": "blank",
            "name": "X",
            "start": 5,
            "end": 5
          }
        ],
        "filled": [],
        "resolved": [],
        "space_run": true
      }
    },
