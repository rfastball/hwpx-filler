{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "문서나르미",
  "version": "0.15.0",
  "identifier": "kr.documentnarmi.app",
  "build": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://ipc.localhost; worker-src 'self' blob:; frame-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../packaging/hwpx-filler.ico"],
    "resources": {
      "../../build/web/": "web/",
      "../../examples/tutorial/물품 구매입찰 공고.hwpx": "examples/tutorial/물품 구매입찰 공고.hwpx",
      "../../examples/tutorial/낙찰자 선정 및 계약체결 안내.txt": "examples/tutorial/낙찰자 선정 및 계약체결 안내.txt",
      "../../examples/tutorial/계약방법 결정 및 구매추진 안내.txt": "examples/tutorial/계약방법 결정 및 구매추진 안내.txt",
      "../../examples/tutorial/공고목록.xlsx": "examples/tutorial/공고목록.xlsx"
    }
  }
}
